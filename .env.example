# ============================================================
# mental-health-agent - environment template
# Copy to `.env` at the project root and edit values.
# NEVER commit the real .env file.
# ============================================================

# ---------- Application ----------
APP_NAME=mental-health-agent
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000

# ---------- Ablation switch: A | B | C | D ----------
#   A = LLM only
#   B = LLM + sentiment + emotion
#   C = LLM + sentiment + emotion + risk (+ post-generation safety)
#   D = full state-aware system (default)
SYSTEM_PROFILE=D

# ---------- Hugging Face model IDs (Phase 3-5) ----------
SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
EMOTION_MODEL_ID=j-hartmann/emotion-english-distilroberta-base
RISK_MODEL_ID=vibhorag101/roberta-base-suicide-prediction-phr
GUARDRAIL_MODEL_ID=mila-ai4h/Mila-Suicide-Prevention-Output-Guardrail

# Set to true only when running offline with models already cached
HF_OFFLINE=false

# ---------- Sentiment module (Phase 3) ----------
# trained    -> models/sentiment/sentiment_pipeline.joblib (fitted on D1)
# pretrained -> SENTIMENT_MODEL_ID used as-is, no fine-tuning
# auto       -> whichever backend has the higher recorded macro-F1 in
#               evaluation/results/sentiment_metrics.json
SENTIMENT_BACKEND=auto
SENTIMENT_MAX_LENGTH=256

# ---------- Emotion module (Phase 4) ----------
# D2 is 28-class; the system space is the 7-class Ekman grouping published by
# the GoEmotions authors (goemotions/data/ekman_mapping.json).
# trained    -> models/emotion/emotion_pipeline.joblib
# pretrained -> EMOTION_MODEL_ID used as-is, no fine-tuning
# auto       -> whichever backend has the higher recorded macro-F1
EMOTION_BACKEND=auto
EMOTION_MAX_LENGTH=256

# ---------- Risk module (Phase 5) ----------
# D3 is BINARY (suicide / non-suicide); low/moderate/high/critical is our own
# fusion of probability thresholds + deterministic rules + trajectory.
# trained    -> models/risk/risk_pipeline.joblib
# pretrained -> RISK_MODEL_ID used as-is, no fine-tuning
# auto       -> whichever backend has the higher recorded macro-F1
RISK_BACKEND=auto
RISK_MAX_LENGTH=256

# ---------- LLM (Phase 9) ----------
# provider: ollama | openai_compatible
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.4

# ---------- State + Memory (Phase 6-7, SQLite backend Phase 14) ----------
SHORT_TERM_WINDOW=8
MAX_STATE_HISTORY=100
MAX_SESSIONS=200
# none | json | sqlite
# json   -> MEMORY_DIR   (one JSON file per session, default data/memory)
# sqlite -> DATABASE_PATH (one SQLite file, default data/sessions.db)
MEMORY_BACKEND=json
MEMORY_DIR=
DATABASE_PATH=
PROFILE_MAX_ITEMS=8

# ---------- Turn audit (Phase 15) ----------
# One metadata row per chat turn in the same SQLite file (table `turns`):
# profile, source, risk/sentiment/emotion labels, safety reason ids, character
# counts, latency - never message or reply text. false = nothing recorded.
TURN_LOG_ENABLED=true
TURN_LOG_MAX_ROWS=10000

# ---------- Safety (Phase 10-11) ----------
# Probability of the positive (risk) class at/above which the level becomes
# moderate / high / critical. Pre-registered; never retuned on the test set.
RISK_MODERATE_THRESHOLD=0.35
RISK_HIGH_THRESHOLD=0.75
RISK_CRITICAL_THRESHOLD=0.92
MAX_MESSAGE_CHARS=4000

# ---------- Paths (leave empty to use defaults) ----------
# Resolved relative to the project root if left empty.
DATA_DIR=
MODELS_DIR=
RESULTS_DIR=
LOG_DIR=

# ---------- Safety (Phase 10 pre / Phase 11 post) ----------
# false = ablation: skip crisis/injection/number content gates (validation stays on)
PRE_SAFETY_ENABLED=true
POST_SAFETY_ENABLED=true
# deterministic checks always come first; the Mila output guardrail is layer 2
POST_SAFETY_GUARDRAIL=true
POST_SAFETY_THRESHOLD=0.5
